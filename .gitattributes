# Normalize line endings in the repository; check out with the platform's default.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.props   text
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.md      text
*.yml     text eol=lf
*.json    text

*.png     binary
*.ico     binary
*.zip     binary
*.snapnote binary
