<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon and the system color dialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SnapshotNotetaker</RootNamespace>
    <AssemblyName>SnapshotNotetaker</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced for NotifyIcon/ColorDialog only; keep its namespaces out of global usings
         so WPF types (Point, Color, Application...) stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Support settings for distributed builds, e.g.
       dotnet publish -c Release -r win-x64 -p:SentryDsn=https://<key>@<org>.ingest.sentry.io/<project> -p:SupportEmail=help@example.com
       Leave SentryDsn empty to ship without remote crash reporting (support bundles still work). -->
  <PropertyGroup>
    <SentryDsn Condition="'$(SentryDsn)' == ''"></SentryDsn>
    <SupportEmail Condition="'$(SupportEmail)' == ''"></SupportEmail>
    <SupportUrl Condition="'$(SupportUrl)' == ''"></SupportUrl>
    <DeploymentEnvironment Condition="'$(DeploymentEnvironment)' == ''">production</DeploymentEnvironment>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" />
    <AssemblyMetadata Include="SupportEmail" Value="$(SupportEmail)" />
    <AssemblyMetadata Include="SupportUrl" Value="$(SupportUrl)" />
    <AssemblyMetadata Include="DeploymentEnvironment" Value="$(DeploymentEnvironment)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sentry" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnapshotNotetaker.Tests" />
  </ItemGroup>

</Project>
