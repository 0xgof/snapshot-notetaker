<Window x:Class="SnapshotNotetaker.Views.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SnapshotNotetaker.Views"
        Title="Help &amp; support — Snapshot Notetaker" Width="620" SizeToContent="Height" MaxHeight="920"
        Style="{StaticResource ChromeWindow}" views:ChromeBehavior.Caption="Help &amp; support"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="12.5" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" Click="Close_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Help}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,18">
                <TextBlock Text="Report a problem" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="IntroText" Style="{StaticResource Help}" Margin="0,0,0,10"/>
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="92" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" views:Hint.Text="What happened? Steps you took, what you expected, what you saw (optional)"/>
                <CheckBox x:Name="IncludeSnapshotCheck" Margin="0,10,0,0"
                          Content="Include the current snapshot (its image and notes) — only if the problem is about it"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Create support bundle…" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="Bundle_Click"/>
                    <Button Content="Copy diagnostic summary" Margin="0,0,8,6" Click="CopySummary_Click"/>
                    <Button Content="Open log folder" Margin="0,0,8,6" Click="OpenLogs_Click"/>
                    <Button x:Name="ContactButton" Content="Contact support" Margin="0,0,8,6" Click="Contact_Click"/>
                </WrapPanel>

                <TextBlock Text="Crash reports" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="CrashReportsCheck" Content="Send crash reports automatically" Click="CrashReports_Click"/>
                <TextBlock x:Name="CrashReportsHelp" Style="{StaticResource Help}" Margin="0,6,0,0"/>

                <TextBlock Text="About" Style="{StaticResource Heading}"/>
                <Grid x:Name="AboutGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
